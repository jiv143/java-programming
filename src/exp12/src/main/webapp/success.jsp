<!DOCTYPE html>
<html>
<head>
    <title>Success</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eaf6f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .message-box {
            background: #ffffff;
            padding: 40px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 4px 12px rgba(0,0,0,0.15);
        }
        h2 {
            color: #28a745;
            margin-bottom: 20px;
        }
        a {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 20px;
            background: #007acc;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
        }
        a:hover {
            background: #005fa3;
        }
    </style>
</head>
<body>
    <div class="message-box">
        <h2>✅ Student Inserted Successfully!</h2>
        <p>The student record has been saved into the database.</p>
        <a href="index.jsp">Insert Another Student</a>
    </div>
</body>
</html>
